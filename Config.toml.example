# =============================================================================
# ScadaViewer — vzorová konfigurace
# Zkopírovat jako Config.toml a upravit před spuštěním.
# =============================================================================

[server]
host = "0.0.0.0"   # naslouchá na všech síťových rozhraních (výrobní LAN + kancelářská síť)
port = 8080
# cors_origins: adresy, přes které prohlížeče aplikaci otevírají — kontroluje se i živé spojení
#   (WebSocket: stav PLC, automatická aktualizace). Kiosk na PC u stroje (localhost) záznam nepotřebuje.
#   ["*"] = libovolná adresa — DOPORUČENO při DHCP ve firemní síti (IP PC u stroje se může změnit).
#   Konkrétní seznam musí obsahovat KAŽDOU adresu / DNS jméno, přes které se otevírá, např.
#   ["http://10.40.84.25:8080", "http://stroj-trafag.firma.local:8080"] — viz 04_docs/deployment.md.
cors_origins = ["*"]

# local_clients — adresy klientů „u stroje" (IP nebo CIDR rozsah).
# Hlavní klient na PC u stroje otevírá http://localhost:8080 → 127.0.0.1 / ::1.
# Jen odsud funguje PLC auto-login a zápisové akce (mazání, čištění úložiště, nastavení,
# správa uživatelů). Ostatní klienti (např. kancelář přes druhou síťovou kartu) = vzdálený
# přístup: přihlášení vlastním účtem, jen prohlížení. Chybí-li klíč, platí výchozí hodnota.
# NEPŘIDÁVAT síť stroje (např. 192.168.1.0/24) — notebook se statickou adresou by dostal plná práva
# a PLC auto-login bez hesla.
local_clients = ["127.0.0.1", "::1"]

[ads]
net_id = "X.X.X.X.1.1"   # AMS Net ID PLC runtime — zjistit v TwinCAT → System → Routes
port   = 851               # TwinCAT PLC runtime port (851 = výchozí)

[data]
# DEV (testovací data v projektu): "05_user_data/test_db_output"
# PROD: absolutní cesta ke sdílené složce, kam DatabaseGateway zapisuje CSV
local_path = "05_user_data/test_db_output"

# NAS — UNC cesta ke sdílené složce; prázdná = Remote tab vždy nedostupný.
# MUSÍ odpovídat DatabaseGateway Config.toml [server]: remote_path = \\{host}\{share}
# a jeho production_path / testing_path = {remote_path}\Production a {remote_path}\Testing.
# Přihlášení k NAS: stejný účet jako DatabaseGateway (cmdkey pro servisní účet — viz 04_docs/deployment.md).
# POZOR: v TOML basic stringu musí být každý \ zapsán jako \\
# Příklad: \\\\10.45.124.20\\trafag_test
remote_path = ""

csv_separator = ";"          # shodné s DatabaseGateway [storage] csv_separator
csv_encoding  = "utf-8-sig"  # shodné s DatabaseGateway [storage] csv_encoding

# Limit lokálního úložiště [GB] — součet CSV v local_path (wip + done_local + done_remote).
# ≥ 80 % = varování, ≥ 95 % = kritické (topbar + banner v Database, tlačítko „Vyčistit").
# Lze změnit i v Nastavení → Připojení (admin+). Chybí-li klíč, platí 5 GB.
local_max_gb = 5.0

[auth]
# Vygenerovat hash před nasazením do produkce:
#   python -c "
#     import hashlib, secrets
#     s = secrets.token_hex(16)
#     h = hashlib.pbkdf2_hmac('sha256', b'VASE_HESLO', bytes.fromhex(s), 260_000).hex()
#     print(f'{s}:{h}')
#   "
# Výchozí (DEV): admin / admin — NEVHODNÉ PRO PRODUKCI
username      = "admin"
password_hash = "655feb7a425c20f21861f3f6d47f686b:3d4da7fee8ec93ebc4ae0bc114e4c5a02c3c408d5310ca6e4e4f8a0190b5cdf0"
